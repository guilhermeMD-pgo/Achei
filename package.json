{
  "name": "achei",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed:promotions": "tsx scripts/db-seed-promotions.ts",
    "start:prod": "tsx scripts/db-migrate.ts && tsx scripts/db-seed.ts && tsx scripts/db-seed-promotions.ts && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "imagens:check": "tsx scripts/check-images.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "next": "15.5.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}